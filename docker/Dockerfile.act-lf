# Toolchain for the Lingua Franca embedded lab (lf-3pi-template) in Docker.
# Place this file in the root of your repo, next to flake.nix.
FROM nixos/nix:latest

# `nix develop` needs flakes, which the official image leaves disabled.
ENV NIX_CONFIG="experimental-features = nix-command flakes"

# Let git and Nix work in a bind-mounted repo owned by a different user.
RUN git config --global --add safe.directory '*'

# Tools the lab normally takes from your OS rather than from Nix:
# Java 17 (to run lfc) and Python 3 (used by the Pico SDK's boot2 build step).
RUN mkdir -p /opt \
 && nix build --out-link /opt/jdk    nixpkgs/nixos-25.05#jdk17_headless \
 && nix build --out-link /opt/python nixpkgs/nixos-25.05#python3
ENV PATH=/root/.local/bin:/opt/jdk/bin:/opt/python/bin:$PATH

# Lingua Franca CLI tools (lfc, lfd, lff), installed into /root/.local/bin.
RUN curl -Ls https://install.lf-lang.org | bash -s cli

# Pre-download everything the repo's dev shell needs, so `nix develop` starts instantly.
# print-dev-env builds the environment without running the shellHook (which needs the full repo).
WORKDIR /opt/lf-env
COPY flake.nix flake.lock shell.nix ./
RUN nix print-dev-env > /dev/null

# Mount your repo here at run time; the container opens straight into the dev shell.
WORKDIR /work
CMD ["nix", "develop"]
